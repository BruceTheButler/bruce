# Copy to .env.signing and fill in once. This is a shell file sourced by the signing target.
# Use the existing Bruce release credentials; keep this file out of git.
DEVELOPMENT_TEAM=''
ASC_KEY_ID=''
ASC_ISSUER_ID=''
# Path to the existing .p8 file. CI continues to use base64 ASC_KEY_CONTENT instead.
ASC_KEY_FILEPATH=''
MATCH_GIT_URL=''
# Match retrieves its passphrase from macOS Keychain, or prompts securely on first use.
# Optional for HTTPS Git authentication; SSH URLs can use your existing SSH identity.
MATCH_GIT_BASIC_AUTHORIZATION=''
